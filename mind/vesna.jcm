mas vesna {

    // Sentry agents - agent names must match Godot node names
    
    agent sentry1:sentry.asl {
        ag-class:   vesna.VesnaAgent
        temper:     temper(aggressiveness(0.6), laziness(0.2), fear(0.0)[mood], sympathy(0.0)[mood])
        address:    localhost
        port:       9071
        strategy:   most_similar
    }

